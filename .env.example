# ─────────────────────────────────────────────────────────────
#  Birthday site config — copy to `.env` and edit.
#  Everything here is optional; leave a value empty to use the default.
#  Use {name} anywhere to insert VITE_FRIEND_NAME.
#  Use | to separate list items. Use \n (inside "double quotes") for new lines.
#  NOTE: these values are baked into the public site at build time,
#  so the passcode is a friendly gate, not real security.
# ─────────────────────────────────────────────────────────────

# Who it's for / from
VITE_FRIEND_NAME=bestie
VITE_SIGNATURE="Forever your partner in crime 🌊"
VITE_PAGE_TITLE="Happy Birthday {name} 🌊"

# Countdown lock — site stays locked until this moment (ISO date with timezone).
# Add ?preview to the URL to skip the countdown while testing.
VITE_COUNTDOWN=true
VITE_BIRTHDAY_AT=2026-09-27T00:00:00+05:30

# Optional passcode screen (leave empty to disable)
VITE_PASSCODE=
VITE_PASSCODE_HINT="Hint: your birthday as DDMM 🐚"

# Landing
VITE_TAGLINE="To the girl who makes every day feel like summer"

# Message-in-a-bottle labels (4 items: collage | letter | memories | final wish)
VITE_BOTTLE_LABELS="Open me first|A little letter|Our memories|Open me last"
VITE_ALL_OPENED_MESSAGE="You found every bottle! Now go blow those candles 🎂"

# Beach (bottles screen) — name written in the sand + notes hidden under the shells
VITE_SAND_TEXT="{name}"
VITE_SHELL_NOTES="your laugh is my favourite sound|you make every plan 10x more fun|you're braver than you think|the world is brighter with you in it|you're the best hype-girl ever"

# Bottle 1 — "favourite human" collage
VITE_FAV_TITLE="My favourite human"
VITE_CHAT_MESSAGES="you're stuck with me forever|no returns, no refunds 😌"

# Bottle 2 — the letter (use \n for paragraph breaks)
VITE_LETTER_TITLE="Dear {name},"
VITE_LETTER="Happy birthday to the one who turns ordinary days into the best stories.\nThank you for every laugh, every late-night talk and every moment you made brighter just by being you.\nI hope this year treats you as kindly as you treat everyone around you."

# Bottle 3 — memories (captions for the swipeable polaroids, in order)
VITE_MEMORIES_TITLE="Summer memories"
VITE_MEMORY_CAPTIONS="the day it all started|us, being iconic|core memory unlocked|more adventures loading..."
VITE_MEMORIES_FOOTER="friends always & forever"

# Bottle 4 — final wish at sunset
VITE_FINAL_TITLE="Make a wish, {name}"
VITE_FINAL_MESSAGE="Out of everyone in the world, I'm so lucky I get to call you my best friend.\nHere's to another year of sunshine, salty hair and silly memories. Happy birthday!"

# Media — photos come from links (recommended for GitHub Pages) or the /photos folder.
# Links: one per line inside "double quotes", optional "| caption" after each.
# Google Drive share links work as-is (set each photo to "Anyone with the link").
# On GitHub, put these lines in the BIRTHDAY_PHOTOS secret instead.
# Order: 1 → collage, 2 → letter, 3+ → memories deck.
VITE_PHOTO_LINKS=
# Or local files in /photos (used only when there are no links):
VITE_PHOTOS=
VITE_SONG_FILE=
VITE_SONG_VOLUME=0.55
